{
	"name": "@glimpse/providers",
	"version": "0.0.6",
	"private": true,
	"description": "OCR and translation provider implementations for Glimpse (Bun APIs, WASM, onnxruntime, fetch). No Electrobun.",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./google": "./src/google/index.ts",
		"./language-detect": "./src/language-detect/index.ts",
		"./ocr/google-vision": "./src/ocr/google-vision/index.ts",
		"./ocr/paddle": "./src/ocr/paddle/index.ts",
		"./translation/bergamot": "./src/translation/bergamot/index.ts",
		"./translation/google-v2": "./src/translation/google-v2/index.ts",
		"./translation/small100": "./src/translation/small100/index.ts",
		"./testing": "./src/testing.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p .",
		"test": "bun test"
	},
	"dependencies": {
		"@glimpse/core": "workspace:*",
		"@huggingface/tokenizers": "0.2.0",
		"eld": "2.1.0",
		"fasttext.wasm.js": "1.0.0",
		"onnxruntime-node": "1.31.1"
	}
}
